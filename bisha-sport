حاضر، تقدر تنسخ الأكواد من الملفات مباشرة. هذي الملفات الثلاثة كاملة:

**1) index.html**

```html
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>نادي علوم الرياضة - جامعة بيشة</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600;700&display=swap">
<style>
:root{--blue:#0b3d7a;--blue-d:#072a57;--blue-l:#e6eef8;--bg:#f4f6f9;--ink:#1c2430;--mute:#5b6675;--line:#d5deea}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"IBM Plex Sans Arabic",Tahoma,sans-serif;line-height:1.8}
header{background:var(--blue);color:#fff;padding:18px 20px;box-shadow:0 2px 10px #0003}
.wrap{max-width:900px;margin:auto}
.head{display:flex;align-items:center;gap:16px}
.logo{width:70px;height:70px;border-radius:50%;background:#fff;object-fit:contain;padding:4px;flex:none}
header h1{margin:0;font-size:1.5rem}
header p{margin:0;opacity:.85}
nav{background:var(--blue-d);display:flex;justify-content:center;gap:6px;flex-wrap:wrap;padding:6px}
nav a{color:#fff;text-decoration:none;padding:6px 16px;border-radius:20px;font-size:.95rem}
nav a:hover,nav a:focus-visible{background:#ffffff26;outline:none}
main{padding:20px 14px 40px}
section{background:#fff;border-radius:18px;padding:22px;margin-bottom:22px;box-shadow:0 2px 12px #0b3d7a14;border-inline-start:6px solid var(--blue)}
h2{margin:0 0 14px;color:var(--blue);font-size:1.35rem}
.ad{border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-bottom:16px}
.ad img{width:100%;display:block;background:var(--blue-l);min-height:120px}
.ad .body{padding:14px 16px}
.ad h3{margin:0 0 6px;font-size:1.1rem}
.dates{display:grid;gap:4px;color:var(--mute);font-size:.93rem;margin:8px 0}
.dates b{color:var(--blue)}
.btn{display:inline-block;background:var(--blue);color:#fff;border:0;border-radius:10px;padding:10px 22px;font:inherit;font-weight:600;cursor:pointer;text-decoration:none}
.btn:hover{background:var(--blue-d)}
.btn:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #6aa0e6;outline-offset:2px}
.btn:disabled{opacity:.6}
ul.pts{padding-inline-start:20px;margin:10px 0 0}
form{display:grid;gap:10px;margin-bottom:18px}
input,textarea{font:inherit;padding:10px 12px;border:1px solid var(--line);border-radius:10px;width:100%;background:#fff}
.note{font-size:.88rem;color:var(--mute)}
.msg{padding:10px 14px;border-radius:10px;background:var(--blue-l);color:var(--blue-d);display:none}
.cm{border-top:1px solid var(--line);padding:12px 0}
.cm b{color:var(--blue)}
.cm small{color:var(--mute);margin-inline-start:8px}
.cm p{margin:4px 0 0;white-space:pre-wrap}
footer{background:var(--blue-d);color:#fff;text-align:center;padding:22px 14px}
</style>
</head>
<body>
<header><div class="wrap head">
<img class="logo" id="logo" alt="شعار النادي">
<div><h1 id="clubName"></h1><p id="uni"></p></div>
</div></header>
<nav><a href="#ads">الإعلانات</a><a href="#about">عن النادي</a><a href="#comments">مشاركات الزوار</a></nav>

<main class="wrap">
<section id="ads"><h2>📢 قسم الإعلانات</h2><div id="adList"></div></section>
<section id="about"><h2 id="aboutTitle"></h2><p id="aboutText"></p><ul class="pts" id="aboutPts"></ul></section>

<section id="comments">
<h2>💬 شاركنا رأيك</h2>
<form id="cForm">
<input id="cName" maxlength="60" placeholder="الاسم" required>
<textarea id="cText" maxlength="500" rows="4" placeholder="اكتب مشاركتك هنا" required></textarea>
<button class="btn" id="cBtn" type="submit">إرسال المشاركة</button>
<div class="note">تظهر المشاركة في الصفحة بعد موافقة إدارة النادي.</div>
</form>
<div class="msg" id="msg" role="status"></div>
<div id="cList"></div>
</section>
</main>

<footer>
<div id="fClub"></div>
<div id="fUni"></div>
</footer>

<script src="config.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>
<script>
const $ = id => document.getElementById(id);
const el = (t, c, txt) => { const e = document.createElement(t); if (c) e.className = c; if (txt) e.textContent = txt; return e; };

// ---- المحتوى من config.js ----
$("clubName").textContent = SITE.clubName;
$("uni").textContent = SITE.university;
$("fClub").textContent = SITE.clubName + " © " + new Date().getFullYear();
$("fUni").textContent = SITE.university;
$("logo").src = SITE.logo;
$("logo").onerror = function(){ this.style.visibility = "hidden"; };
$("aboutTitle").textContent = SITE.about.title;
$("aboutText").textContent = SITE.about.text;
SITE.about.points.forEach(p => $("aboutPts").appendChild(el("li", "", p)));

if (!SITE.announcements.length) $("adList").appendChild(el("p", "note", "سيتم عرض إعلانات وفعاليات النادي هنا."));
SITE.announcements.forEach(a => {
const d = el("article", "ad");
if (a.image) { const i = el("img"); i.src = a.image; i.alt = a.title; i.onerror = () => i.remove(); d.appendChild(i); }
const b = el("div", "body");
b.appendChild(el("h3", "", a.title));
const dt = el("div", "dates");
[["بداية الإعلان", a.startDate], ["بداية التقديم", a.registerFrom], ["نهاية التقديم", a.registerTo]].forEach(([k, v]) => {
if (!v) return; const r = el("div"); r.appendChild(el("b", "", k + ": ")); r.appendChild(document.createTextNode(v)); dt.appendChild(r);
});
b.appendChild(dt);
if (a.details) b.appendChild(el("p", "", a.details));
if (a.link) { const l = el("a", "btn", "التقديم الآن"); l.href = a.link; l.target = "_blank"; l.rel = "noopener"; b.appendChild(l); }
d.appendChild(b); $("adList").appendChild(d);
});

// ---- التعليقات (Firebase) ----
const msg = t => { $("msg").textContent = t; $("msg").style.display = "block"; };
if (FIREBASE_CONFIG.apiKey === "PASTE_HERE") {
$("cForm").style.display = "none";
msg("قسم المشاركات غير مفعّل بعد: أضف إعدادات Firebase في ملف config.js.");
} else {
firebase.initializeApp(FIREBASE_CONFIG);
const col = firebase.firestore().collection("comments");

$("cForm").addEventListener("submit", async e => {
e.preventDefault();
$("cBtn").disabled = true;
try {
await col.add({
name: $("cName").value.trim(), text: $("cText").value.trim(),
approved: false, createdAt: firebase.firestore.FieldValue.serverTimestamp()
});
$("cForm").reset();
msg("وصلت مشاركتك، وستظهر بعد موافقة إدارة النادي.");
} catch (err) { msg("تعذر الإرسال، حاول مرة أخرى."); }
$("cBtn").disabled = false;
});

col.where("approved", "==", true).orderBy("createdAt", "desc").limit(50).onSnapshot(s => {
$("cList").replaceChildren();
s.forEach(doc => {
const c = doc.data(), r = el("div", "cm");
const h = el("div"); h.appendChild(el("b", "", c.name));
if (c.createdAt) h.appendChild(el("small", "", c.createdAt.toDate().toLocaleDateString("ar-SA")));
r.appendChild(h); r.appendChild(el("p", "", c.text)); $("cList").appendChild(r);
});
}, err => console.error(err));
}
</script>
</body>
</html>
```

