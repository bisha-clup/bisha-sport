**3) admin.html** (صفحة قبول ورفض المشاركات)

```html
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>إدارة المشاركات</title>
<style>
:root{--blue:#0b3d7a;--line:#d5deea}
body{margin:0;background:#f4f6f9;font-family:Tahoma,sans-serif;line-height:1.8;color:#1c2430}
.w{max-width:700px;margin:auto;padding:20px 14px}
h1{color:var(--blue);font-size:1.4rem}h2{font-size:1.1rem;color:var(--blue);margin-top:26px}
.card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:10px}
.card p{margin:4px 0 10px;white-space:pre-wrap}
input{font:inherit;padding:10px;border:1px solid var(--line);border-radius:10px;width:100%;margin-bottom:8px}
button{font:inherit;border:0;border-radius:10px;padding:8px 18px;cursor:pointer;color:#fff;background:var(--blue);margin-inline-end:6px}
button.no{background:#b3261e}button.gr{background:#667085}
.note{color:#667085;font-size:.9rem}
</style>
</head>
<body><div class="w">
<h1>إدارة مشاركات الزوار</h1>

<div id="login">
<input id="em" type="email" placeholder="البريد الإلكتروني" autocomplete="username">
<input id="pw" type="password" placeholder="كلمة المرور" autocomplete="current-password">
<button id="go">دخول</button>
<div class="note" id="err"></div>
</div>

<div id="panel" style="display:none">
<button class="gr" id="out">تسجيل خروج</button>
<h2>بانتظار الموافقة</h2><div id="pend"></div>
<h2>المنشورة</h2><div id="appr"></div>
</div>
</div>

<script src="config.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>
<script>
const $ = id => document.getElementById(id);
firebase.initializeApp(FIREBASE_CONFIG);
const auth = firebase.auth(), col = firebase.firestore().collection("comments");

$("go").onclick = () => auth.signInWithEmailAndPassword($("em").value, $("pw").value)
.catch(() => $("err").textContent = "بيانات الدخول غير صحيحة.");
$("out").onclick = () => auth.signOut();

let unsub = null;
auth.onAuthStateChanged(u => {
$("login").style.display = u ? "none" : "block";
$("panel").style.display = u ? "block" : "none";
if (unsub) unsub();
if (!u) return;
unsub = col.orderBy("createdAt", "desc").onSnapshot(s => {
$("pend").replaceChildren(); $("appr").replaceChildren();
s.forEach(d => {
const c = d.data(), card = document.createElement("div");
card.className = "card";
const n = document.createElement("b"); n.textContent = c.name;
const p = document.createElement("p"); p.textContent = c.text;
card.append(n, p);
if (!c.approved) {
const a = document.createElement("button"); a.textContent = "قبول ونشر";
a.onclick = () => col.doc(d.id).update({ approved: true });
card.append(a);
} else {
const h = document.createElement("button"); h.className = "gr"; h.textContent = "إخفاء";
h.onclick = () => col.doc(d.id).update({ approved: false });
card.append(h);
}
const r = document.createElement("button"); r.className = "no"; r.textContent = "حذف";
r.onclick = () => confirm("حذف المشاركة نهائيًا؟") && col.doc(d.id).delete();
card.append(r);
(c.approved ? $("appr") : $("pend")).append(card);
});
if (!$("pend").children.length) $("pend").innerHTML = '<div class="note">لا توجد مشاركات بانتظار الموافقة.</div>';
}, e => $("err").textContent = "ليس لديك صلاحية الإدارة.");
});
</script>
</body>
</html>
```
